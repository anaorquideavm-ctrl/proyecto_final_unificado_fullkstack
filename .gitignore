# ==========================================
# 1. Variables de entorno y secretos
# ==========================================
.env/
.env.local/
.env.development.local/
.env.test.local/
.env.production.local/
*.env

# ==========================================
# 2. Dependencias de Node.js (Servicios y Frontend)
# ==========================================
node_modules/
**/node_modules/
package-lock.json (opcional, si prefieres no rastrear versiones exactas)

# ==========================================
# 3. Compilación y builds del Frontend (React / Vite)
# ==========================================
frontend/dist/
frontend/build/
dist/
build/
*.tsbuildinfo

# ==========================================
# 4. Logs de ejecución y depuración
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# 5. Cobertura de pruebas (Vitest / Jest)
# ==========================================
coverage/
**/coverage/
.nyc_output/

# ==========================================
# 6. Archivos generados por el Sistema Operativo y Editores
# ==========================================
.DS_Store
.DS_Store?
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.suo
*.user
*.userossc
*.sln.docstates

# ==========================================
# 7. Archivos temporales comprimidos o reportes
# ==========================================
*.zip
*.tar.gz
*.rar